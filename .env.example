# Local dev: set AUTH_DISABLED=true to bypass Replit OIDC discovery
AUTH_DISABLED=true

# Required for DB-backed sessions and persistence
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
SESSION_SECRET=replace-me

# Replit Auth (OIDC)
REPL_ID=replace-me
ISSUER_URL=https://replit.com/oidc
